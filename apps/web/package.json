{
  "name": "chessmark-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3010",
    "build": "next build",
    "start": "next start -p 3010",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=public",
    "test:e2e:all": "playwright test"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.8.0",
    "chess.js": "^1.4.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-chessboard": "^5.12.0",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.28",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.21.0"
}
