# Copy to .env and fill in. Never commit .env.
#
# NOTE ON PORTS: this machine already runs other projects on 3000/8000/5432/6379.
# Chessmark deliberately uses its own block (3010/8010/5433/6380) so everything
# can run side by side. Change only if you know those are free.

# ---------------------------------------------------------------- runtime
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO

# ---------------------------------------------------------------- api
API_HOST=0.0.0.0
API_PORT=8010
CORS_ORIGINS=["http://localhost:3010"]

# ---------------------------------------------------------------- postgres
POSTGRES_USER=chessmark
POSTGRES_PASSWORD=chessmark
POSTGRES_DB=chessmark
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://chessmark:chessmark@localhost:5433/chessmark

# ---------------------------------------------------------------- redis
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/0

# ---------------------------------------------------------------- llm
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---------------------------------------------------------------- auth (clerk)
# https://dashboard.clerk.com
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWKS_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# ---------------------------------------------------------------- frontend
WEB_PORT=3010
NEXT_PUBLIC_API_URL=http://localhost:8010

# ---------------------------------------------------------------- cost & abuse controls
MAX_USD_PER_GAME=1.00
MAX_GAMES_PER_USER_PER_DAY=20
GLOBAL_DAILY_USD_BUDGET=25.00

# ---------------------------------------------------------------- match rules
MAX_ILLEGAL_MOVE_RETRIES=5
MAX_MOVES_PER_GAME=300
