# Copy to .env and fill in. Never commit .env.
#
# NOTE ON PORTS: this machine already runs other projects on 3000/8000/5432/6379.
# Chessmark deliberately uses its own block (3010/8010/5433/6380) so everything
# can run side by side. Change only if you know those are free.

# ---------------------------------------------------------------- runtime
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO

# ---------------------------------------------------------------- api
API_HOST=0.0.0.0
API_PORT=8010
CORS_ORIGINS=["http://localhost:3010"]

# ---------------------------------------------------------------- postgres
POSTGRES_USER=chessmark
POSTGRES_PASSWORD=chessmark
POSTGRES_DB=chessmark
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://chessmark:chessmark@localhost:5433/chessmark

# ---------------------------------------------------------------- redis
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/0

# ---------------------------------------------------------------- llm
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---------------------------------------------------------------- auth (clerk)
# https://dashboard.clerk.com
#
# Optional for local development. Left blank, the site runs signed-out: watching, replays, and
# `make play` all work, and only the create-game API refuses. In production the API refuses to
# start without these (see `Settings.production_problems`).
#
# Only NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY reaches the browser — that one is designed to be public.
# CLERK_SECRET_KEY and CLERK_WEBHOOK_SECRET must never be prefixed NEXT_PUBLIC_; CI greps the
# built bundle for them (AUTH-07, `scripts/check_bundle_secrets.py`).
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Dashboard → API keys → Show JWT public key → JWKS URL
CLERK_JWKS_URL=
# The `iss` every token must carry, e.g. https://your-app.clerk.accounts.dev
# Without it, a token from anyone else's Clerk instance verifies against their JWKS and passes.
CLERK_ISSUER=
# Dashboard → Webhooks → your endpoint → Signing Secret (whsec_...)
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# ------------------------------------------------- cost & abuse controls (ADR-0011)
# Four independent layers. Any one will eventually have a bug; they are separate so that a
# failure is contained rather than total. Set to 0 to disable a layer — which means *no limit*,
# not "refuse everything".
MAX_USD_PER_GAME=1.00
MAX_GAMES_PER_USER_PER_DAY=20
MAX_USD_PER_USER_PER_DAY=5.00
GLOBAL_DAILY_USD_BUDGET=25.00
RATE_LIMIT_PER_WINDOW=10
RATE_LIMIT_WINDOW_SECONDS=60

# How many turn workers run. A worker plays one turn at a time start to finish, and a free
# model's turn takes 17–38 seconds, so with one worker a person's game queues behind whatever the
# pool is doing. The queue is a Redis Streams consumer group: extra workers share jobs rather than
# duplicating them. One per concurrent game you want moving independently.
WORKER_REPLICAS=1

# ---------------------------------------------------------------- frontend
WEB_PORT=3010
# Both are read at **build** time and baked into the client bundle, so an image built for one
# origin cannot serve another. Leaving either blank is not the same as leaving it unset: an empty
# value used to survive as an empty base URL. `lib/env.ts` records what that cost.
NEXT_PUBLIC_API_URL=http://localhost:8010
# The site's own origin, used by `metadataBase`, the OpenGraph card and the sitemap. Wrong here
# means every canonical URL and every indexed link points somewhere that is not the site.
NEXT_PUBLIC_SITE_URL=http://localhost:3010

# ---------------------------------------------------------------- match rules
MAX_ILLEGAL_MOVE_RETRIES=5
MAX_MOVES_PER_GAME=300
