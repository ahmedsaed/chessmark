# --- Secrets ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# --- Node / Next.js ---
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
.pnpm-store/

# --- Data / artifacts ---
data/
storage/
*.db
*.sqlite3
logs/
*.log

# --- Editors / OS ---
.DS_Store
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# --- Claude Code ---
.claude/settings.local.json

# Playwright MCP scratch output — screenshots and snapshots from manual verification
.playwright-mcp/

# stray screenshots from browser-driven checks
*.png
!apps/web/public/**/*.png
# App Router metadata icons are source, not screenshots. Without this the apple-touch icon is
# ignored on the way in and the deployed site 404s it — silently, since nothing fails locally.
!apps/web/src/app/**/*.png

# Database dumps. Local operational state, and they contain real data.
/backups/

# Lighthouse CI writes its reports here; they are artifacts of a run, not of the repo.
.lighthouseci/

# A real Clerk session JWT, written by the browser suite. Never committed.
e2e/.auth/
apps/web/e2e/.auth/
apps/web/e2e/.fixtures.json
