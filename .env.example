# Copy to .env and fill in. Never commit .env.
#
# NOTE ON PORTS: this machine already runs other projects on 3000/8000/5432/6379.
# Chessmark deliberately uses its own block (3010/8010/5433/6380) so everything
# can run side by side. Change only if you know those are free.

# ---------------------------------------------------------------- runtime
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO

# ---------------------------------------------------------------- api
API_HOST=0.0.0.0
API_PORT=8010
CORS_ORIGINS=["http://localhost:3010"]

# ---------------------------------------------------------------- postgres
POSTGRES_USER=chessmark
POSTGRES_PASSWORD=chessmark
POSTGRES_DB=chessmark
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://chessmark:chessmark@localhost:5433/chessmark

# ---------------------------------------------------------------- redis
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/0

# ---------------------------------------------------------------- llm
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# A management key (openrouter.ai/settings/management-keys), read-only in our use: reconciliation
# asks OpenRouter's analytics what each game's session was billed (ADR-0054). Empty turns it off.
# It can create and delete keys — keep it on the server only.
OPENROUTER_MANAGEMENT_KEY=

# App attribution — our usage counted as ours, on openrouter.ai/apps. Rankings and analytics only;
# it unlocks no model (see agents/attribution.py). Blank falls back to the first CORS origin.
APP_URL=
APP_TITLE=Chessmark
# Marketplace categories on openrouter.ai/apps. Two at most; unknown names are dropped silently.
APP_CATEGORIES=game

# Stream reasoning token by token from the provider (ADR-0035). On: LiteLLM's streaming path drops
# `reasoning` on some providers, but a response that reports billed reasoning tokens and returns no
# reasoning text gives that away exactly, and the endpoint falls back to whole responses on the
# spot. Set false to stop asking providers to stream; rounds stream either way.
LLM_STREAM=true

# ---------------------------------------------------------------- auth (clerk)
# https://dashboard.clerk.com
#
# Optional for local development. Left blank, the site runs signed-out: watching, replays, and
# `make play` all work, and only the create-game API refuses. In production the API refuses to
# start without these (see `Settings.production_problems`).
#
# Only NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY reaches the browser — that one is designed to be public.
# CLERK_SECRET_KEY and CLERK_WEBHOOK_SECRET must never be prefixed NEXT_PUBLIC_; CI greps the
# built bundle for them (AUTH-07, `scripts/check_bundle_secrets.py`).
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Dashboard → API keys → Show JWT public key → JWKS URL
CLERK_JWKS_URL=
# The `iss` every token must carry, e.g. https://your-app.clerk.accounts.dev
# Without it, a token from anyone else's Clerk instance verifies against their JWKS and passes.
CLERK_ISSUER=
# Dashboard → Webhooks → your endpoint → Signing Secret (whsec_...)
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# ------------------------------------------------- selling credit (Paddle, ADR-0055, ADR-0056)
# All empty keeps selling off: /credit shows the amounts with "not on sale yet". Sandbox and live
# are separate Paddle accounts with separate catalogues, keys and secrets — never mix them.
#
# Server. The notification destination's secret (Developer tools → Notifications); an API key that
# can create transactions (Developer tools → Authentication; `pdl_sdbx_…` sandbox or `pdl_live_…`
# live, which also picks the environment); and the "Chessmark credit" product every purchase is a
# price of. Selling also needs OPENROUTER_MANAGEMENT_KEY: it measures how much credit can be sold.
PADDLE_WEBHOOK_SECRET=
PADDLE_API_KEY=
# pro_…
PADDLE_PRODUCT_ID=
# Optional: a $1 price of that product, never sold, previewed in quantity to estimate tax on /credit.
PADDLE_TAX_PREVIEW_PRICE_ID=
# OpenRouter credit kept back from sale, for our own tournaments and turns in flight.
CREDIT_RESERVE_USD=10
# Browser, baked in at build time. The client-side token (Developer tools → Authentication), public
# by design: `test_…` for sandbox, `live_…` for production. The environment is required whenever a
# token is set — the build refuses to guess it, so a sandbox token never meets the live checkout.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# sandbox | production
NEXT_PUBLIC_PADDLE_ENV=

# ------------------------------------------------- cost & abuse controls (ADR-0011)
# Four independent layers. Any one will eventually have a bug; they are separate so that a
# failure is contained rather than total. Set to 0 to disable a layer — which means *no limit*,
# not "refuse everything".
# There is no server-wide per-game limit: a game somebody starts spends their own credit, and
# they may set a limit of their own; a tournament sets its own (ADR-0052).
MAX_GAMES_PER_USER_PER_DAY=20
MAX_USD_PER_USER_PER_DAY=5.00
GLOBAL_DAILY_USD_BUDGET=25.00
RATE_LIMIT_PER_WINDOW=10
RATE_LIMIT_WINDOW_SECONDS=60

# How many turn workers run. A worker plays one turn at a time start to finish, and a free
# model's turn takes 17–38 seconds, so with one worker a person's game queues behind whatever the
# pool is doing. The queue is a Redis Streams consumer group: extra workers share jobs rather than
# duplicating them. One per concurrent game you want moving independently.
WORKER_REPLICAS=1

# How often the stack refreshes the model catalogue from OpenRouter (OPS-23). The first pass runs
# at start-up and then every N hours. Prices set the spend caps *and* what users are charged in
# credits, and endpoint rows are what the picker pins to, so a stale catalogue is a wrong cap, a
# wrong price and a field of models that cannot be played. It spends nothing: `/models` and
# `/endpoints` are metadata, not inference.
CATALOGUE_INTERVAL_HOURS=12

# ---------------------------------------------------------------- frontend
WEB_PORT=3010
# Both are read at **build** time and baked into the client bundle, so an image built for one
# origin cannot serve another. Leaving either blank is not the same as leaving it unset: an empty
# value used to survive as an empty base URL. `lib/env.ts` records what that cost.
NEXT_PUBLIC_API_URL=http://localhost:8010
# The site's own origin, used by `metadataBase`, the OpenGraph card and the sitemap. Wrong here
# means every canonical URL and every indexed link points somewhere that is not the site.
NEXT_PUBLIC_SITE_URL=http://localhost:3010

# ---------------------------------------------------------------- cache invalidation (ADR-0046)
# The website caches every public read and tags it; the API posts here to say a tag is stale the
# moment a game changes, rather than the site guessing on a clock.
#
# Both blank is a supported configuration and the local default: nothing is posted, and the site
# falls back to the `revalidate` seconds its reads already carry. Correct, just staler.
#
# Set them together. The web tier *refuses* the endpoint when its half is unset, so a deployment
# with only the API half configured logs a 401 per turn and caches exactly as if neither were set.
# Generate with: openssl rand -hex 32
WEB_ORIGIN=http://localhost:3010
REVALIDATE_SECRET=

# ---------------------------------------------------------------- match rules
MAX_ILLEGAL_MOVE_RETRIES=5
MAX_MOVES_PER_GAME=300

# Where `make dev-pull` reaches the server, as ssh spells it. Unset on the server itself; on a
# development machine this is the whole configuration that command needs, which is why it lives
# here rather than in an export somebody has to remember.
CHESSMARK_SSH=
